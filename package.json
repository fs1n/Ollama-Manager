{
  "name": "ollama-manager",
  "version": "1.0.0-BETA",
  "description": "Web UI for managing Ollama models, with automatic LiteLLM model sync",
  "type": "module",
  "scripts": {
    "predev": "bun run build:web",
    "dev": "bun run --watch src/index.ts",
    "prestart": "bun run build:web",
    "start": "bun run src/index.ts",
    "build:web": "bun build public/index.html --outdir dist/public --sourcemap=linked",
    "dev:web": "bun build public/index.html --outdir dist/public --sourcemap=linked --watch",
    "lint": "biome check .",
    "lint:fix": "biome check . --write",
    "format": "biome format . --write",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p public/tsconfig.json",
    "test": "bun test",
    "test:coverage": "bun test --coverage"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@happy-dom/global-registrator": "^20.14.5",
    "@types/bun": "^1.4.2",
    "happy-dom": "^20.14.5",
    "typescript": "7"
  },
  "dependencies": {
    "node-html-parser": "^9.0.1"
  },
  "packageManager": "bun@1.3.11"
}
